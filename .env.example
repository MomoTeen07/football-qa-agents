# LLM gratuit — Gemini principal, Groq/Mistral en secours
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
LLM_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
MISTRAL_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=496100274

# Stack de test
TEST_API_URL=http://localhost:8002
TEST_UI_URL=http://localhost:5175
TEST_DB_HOST=localhost
TEST_DB_PORT=5434
TEST_DB_NAME=footballqa_test
TEST_DB_USER=football
TEST_DB_PASSWORD=football

# Comptes de test
TEST_USER1_EMAIL=qa.user1@example.com
TEST_USER1_PASSWORD=QaTest123!
TEST_USER2_EMAIL=qa.user2@example.com
TEST_USER2_PASSWORD=QaTest123!

# Orchestrateur
MISSION_DB_PATH=workspace/missions.db
LOG_LEVEL=INFO

# Bureau virtuel (phase 8) : lien renvoyé par le bot à la création d'une mission.
# L'URL doit rester locale : le serveur n'écoute que sur la boucle locale.
OFFICE_URL=http://127.0.0.1:5180

# Agents réels phase 5 (LLM Gemini + sondes API sur la stack de test)
REAL_AGENTS_ENABLED=false

# Agent 6 DevOps (phase 7) — publication strictement opt-in
DEVOPS_PUBLISH_ENABLED=false
DEVOPS_REMOTE=origin
DEVOPS_BASE_BRANCH=main
# DEVOPS_REPO_DIR=C:\chemin\vers\football-qa-agents
# DEVOPS_TIMEOUT_SECONDS=120

# Reporting Allure (phase 7) — dossier des résultats JSON standard
# Défaut : <racine du projet>/reports/allure-results
# ALLURE_RESULTS_DIR=C:\chemin\vers\reports\allure-results
